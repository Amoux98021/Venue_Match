{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,web/**,data/processed/**,data/raw/**,**/__pycache__/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/ingestion/sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/evaluation/jambase-history-probe",
      "schedule": "0 8 * * *"
    }
  ]
}
